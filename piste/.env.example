# Piste environment variables. Copy to .env.local and fill in what you need. Nothing here is required to run.

# --- Storage -------------------------------------------------------------------------------------------------
# Directory for SQLite files (live: piste.db, demo: piste-demo.db). Must be persistent storage.
# PISTE_DATA_DIR=./data
# Explicit path of the live database file (overrides PISTE_DATA_DIR for live data only).
# PISTE_DB_FILE=

# --- Access control ------------------------------------------------------------------------------------------
# Set a passcode before exposing Piste beyond localhost. When set, every page and API requires sign-in.
# PISTE_PASSCODE=
# Secret used to sign the session cookie (32+ random characters). Required when PISTE_PASSCODE is set.
# PISTE_SESSION_SECRET=

# --- Weather -------------------------------------------------------------------------------------------------
# NWS asks every client to identify itself with a User-Agent that includes contact details.
# PISTE_CONTACT=you@example.com
# Open-Meteo is used without a key under its free non-commercial terms. For commercial use set a customer key:
# OPEN_METEO_API_KEY=

# --- Optional integrations -----------------------------------------------------------------------------------
# Duffel flight offers (test tokens start with duffel_test_). Leave empty to use search links + manual quotes.
# DUFFEL_ACCESS_TOKEN=
# Not implemented yet (reserved): openrouteservice driving-time routing. Nothing reads this variable today; drive
# times are curated estimates plus map direction links.
# ORS_API_KEY=

# --- Providers -----------------------------------------------------------------------------------------------
# Switch providers off (comma-separated ids). Refresh jobs never call a disabled provider, and its runs do not count
# as "last successful update": open-meteo, nws-grid, nws-alerts, frankfurter, link-check, alta-official,
# greek-peak-official. `duffel` (on-demand flight offers) is also accepted and shown as disabled on Sources.
# PISTE_DISABLED_PROVIDERS=nws-grid

# --- Scheduler (npm run worker / npm run refresh) ------------------------------------------------------------
# Refresh cadences in minutes. Invalid or non-positive values fall back to the defaults shown.
# PISTE_WEATHER_EVERY_MIN=180
# Official resort reports: daytime cadence (06:00–18:00 resort-local) and night cadence.
# PISTE_REPORTS_EVERY_MIN=60
# PISTE_REPORTS_NIGHT_EVERY_MIN=240
# Official NWS weather alerts (watches/warnings). Piste's own in-app alerts run after every refresh pass.
# PISTE_ALERTS_EVERY_MIN=60
# Operating status derived from season dates (announced opening reached, season closed).
# PISTE_STATUS_EVERY_MIN=60
# Conditions assessments (also recomputed right after new weather/report/status data).
# PISTE_ASSESSMENTS_EVERY_MIN=360
# PISTE_LINKS_EVERY_MIN=1440
# PISTE_FX_EVERY_MIN=1440
# PISTE_PRUNE_EVERY_MIN=1440
# How often the worker checks for due jobs (seconds).
# PISTE_WORKER_TICK_SECONDS=60
# Random jitter added to each due time, as a fraction of the cadence (0 <= value < 1; 0.1 = ±10 %).
# PISTE_SCHEDULER_JITTER=0.1
# Weather runs from the last N days are all kept; older ones keep the first good run per point and resort-local day.
# PISTE_WEATHER_RETENTION_DAYS=14
# /api/health reports the scheduler as stale after this many minutes without a heartbeat.
# Default: 5 for `npm run worker`, 240 when `npm run refresh` runs from cron.
# PISTE_HEALTH_MAX_HEARTBEAT_MIN=

# --- Backups (npm run backup / npm run restore) --------------------------------------------------------------
# Number of backups kept (positive integer; --keep overrides).
# PISTE_BACKUP_KEEP=14
# Backup directory (default ./data/backups; --dir overrides). Demo backups go to its demo/ subdirectory
# (default ./data/backups-demo), so live and demo backups never share a directory.
# PISTE_BACKUP_DIR=

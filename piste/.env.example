# Piste environment variables. Copy to .env.local and fill in what you need. Nothing here is required to run.

# --- Storage -------------------------------------------------------------------------------------------------
# Directory for SQLite files (live: piste.db, demo: piste-demo.db). Must be persistent storage.
# PISTE_DATA_DIR=./data

# --- Access control ------------------------------------------------------------------------------------------
# Set a passcode before exposing Piste beyond localhost. When set, every page and API requires sign-in.
# PISTE_PASSCODE=
# Secret used to sign the session cookie (32+ random characters). Required when PISTE_PASSCODE is set.
# PISTE_SESSION_SECRET=

# --- Weather -------------------------------------------------------------------------------------------------
# NWS asks every client to identify itself with a User-Agent that includes contact details.
# PISTE_CONTACT=you@example.com
# Open-Meteo is used without a key under its free non-commercial terms. For commercial use set a customer key:
# OPEN_METEO_API_KEY=

# --- Optional integrations -----------------------------------------------------------------------------------
# Duffel flight offers (test tokens start with duffel_test_). Leave empty to use search links + manual quotes.
# DUFFEL_ACCESS_TOKEN=
# openrouteservice driving-time routing. Leave empty to use curated estimates + map direction links.
# ORS_API_KEY=

# --- Scheduler -----------------------------------------------------------------------------------------------
# Override refresh cadences (minutes). Defaults: weather 180, reports 60 (operating hours), links 1440, fx 1440.
# PISTE_WEATHER_EVERY_MIN=180
# PISTE_REPORTS_EVERY_MIN=60
